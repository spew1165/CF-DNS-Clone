# 表示这是最顶层的配置文件，编辑器会停止向上查找[reference:22][reference:23][reference:24]
root = true

# 适用于所有文件的通用规则[reference:25][reference:26]
[*]
indent_style = space          # 使用空格缩进[reference:27][reference:28]
indent_size = 4              # 缩进大小为4个空格[reference:29]
end_of_line = lf              # 使用 Unix 风格的换行符[reference:30]
charset = utf-8               # 文件编码为 UTF-8[reference:31]
trim_trailing_whitespace = true # 移除行尾空白字符[reference:32]
insert_final_newline = true   # 文件末尾插入一个新行[reference:33]

[*.{js,ts,jsx,tsx}]
indent_size = 4

# 针对 Markdown 文件的特殊规则[reference:34]
[*.md]
trim_trailing_whitespace = false

# 针对 Makefile 文件的特殊规则[reference:35]
[Makefile]
indent_style = tab
indent_size = 4