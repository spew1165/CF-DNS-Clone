{
    "compilerOptions": {
        "target": "es2022",
        "module": "esnext",
        "moduleResolution": "bundler",
        "strict": true,
        "noImplicitAny": true,
        "allowJs": true,
        "checkJs": false,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "noEmit": true,
        "isolatedModules": true,
        "resolveJsonModule": true,
        "allowImportingTsExtensions": true,
        "types": []
    },
    "include": ["src/**/*.ts", "src/**/*.js", "worker-configuration.d.ts"],
    "exclude": ["node_modules", ".wrangler", "dist", "coverage", "src/ui/templates.js"]
}
